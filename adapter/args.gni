import("//build_overrides/chip.gni")
import("${chip_root}/config/standalone/args.gni")

# chip-tool's project configuration serves both targets. The SDK is compiled
# once per gn root, so the sidecar and the diagnostic share every object file
# and, necessarily, every compile-time option.
chip_device_project_config_include = "<CHIPProjectAppConfig.h>"
chip_project_config_include = "<CHIPProjectAppConfig.h>"
chip_system_project_config_include = "<SystemProjectConfig.h>"
chip_project_config_include_dirs = [
  "${chip_root}/examples/chip-tool/include",
  "${chip_root}/config/standalone",
]

# mDNS through Avahi, not the SDK's own resolver: the box runs Avahi already,
# and the OTBR backend will hang on the same daemon.
chip_mdns = "platform"

# No perfetto: the tracing backend is chip-tool's command-line concern, and a
# sidecar that carried it would need the registry the tracing code links in.
matter_enable_tracing_support = false
matter_log_json_payload_hex = true
matter_log_json_payload_decode_full = true
chip_tlv_validate_char_string_on_read = true
chip_tlv_validate_char_string_on_write = true
