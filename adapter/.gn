# GN root for the phi Matter sidecar. The SDK checkout is reached through
# third_party/connectedhomeip and build_overrides, both symlinks the build
# script lays before gn runs; the checkout itself stays untouched.
import("//build_overrides/build.gni")

buildconfig = "${build_root}/config/BUILDCONFIG.gn"

# CHIP uses angle bracket includes.
check_system_includes = true

default_args = {
  import("//args.gni")
}
