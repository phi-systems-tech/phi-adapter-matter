#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake --builddirectory=build/deb

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DPHI_ADAPTER_MATTER_USE_LOCAL_ADAPTER_SDK=OFF

override_dh_shlibdeps:
	dh_shlibdeps -l/usr/lib/$(DEB_HOST_MULTIARCH)

# The SDK is linked in statically; the package records which build of it.
override_dh_gencontrol:
	dh_gencontrol -- -Vchip:Built-Using="$$(dpkg-query -f '$${source:Package} (= $${source:Version})' -W phi-chip-dev)"
